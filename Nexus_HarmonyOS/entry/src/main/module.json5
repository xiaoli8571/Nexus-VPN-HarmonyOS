{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.GET_NETWORK_INFO" },
      { "name": "ohos.permission.KEEP_BACKGROUND_RUNNING", "reason": "$string:bg_task_reason", "usedScene": { "abilities": ["EntryAbility", "VpnExtensionAbility"], "when": "inuse" } },
      { "name": "ohos.permission.GET_BUNDLE_INFO" }
      // 权限红线（安装 ACL 校验会失败的受限权限，一律不得声明）：
      //   ohos.permission.MANAGE_VPN / NOTIFICATION_CONTROLLER / START_ABILITIES_FROM_BACKGROUND
      // HarmonyOS 6.x 上 type:"vpn" 的 VpnExtensionAbility 无需上述权限即可安装运行，
      // 运行时由系统 VPN 授权弹框管控（同 Android）。参照 NekoBox4Harmony 已验证做法。
      // 自己应用的通知用 notificationManager.publish 即可，不需要 NOTIFICATION_CONTROLLER。
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:ability_desc",
        "icon": "$media:layered_image",
        "label": "$string:app_name",
        "startWindowIcon": "$media:start_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // App 内手动连接路径的会话守护：连接成功后注册 dataTransfer 连续任务，
        // 防止 UI 进程退后台被杀连带回收 VpnExtensionAbility（真机取证 2026-09-24）。
        "backgroundModes": ["dataTransfer"],
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      },
      // 桌面「启动代理」快捷方式已按用户要求下线（2026-09-10）。
      // QuickToggleAbility.ets 与 VpnQuickStart.ets 源码保留但不再声明，
      // 需要时重新加入本数组并在 resources/base/profile 恢复 shortcuts_config.json 即可。
      {
        // 长按图标「启动代理」与服务卡片点击的共同目标: 无界面宿主, 后台拨 VPN;
        // 连接成功后转为会话守护者(注册 dataTransfer 连续任务), 断开时才自毁, 不进 App
        "name": "QuickToggleAbility",
        "srcEntry": "./ets/quicktoggleability/QuickToggleAbility.ets",
        "description": "$string:ability_desc",
        "icon": "$media:layered_image",
        "label": "$string:app_name",
        "startWindowIcon": "$media:start_icon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "singleton",
        "removeMissionAfterTerminate": true,
        // 连续任务只能在 UIAbility 上下文注册（扩展进程内必然 401，真机实证）；
        // dataTransfer 为第三方手机可用模式，守护 :vpn 会话存活期间本能力保持驻留。
        "backgroundModes": ["dataTransfer"],
        "exported": false
      }
    ],
    "extensionAbilities": [
      {
        "name": "VpnExtensionAbility",
        "srcEntry": "./ets/vpnability/VpnExtensionAbility.ets",
        "type": "vpn",
        "description": "$string:vpn_desc",
        "exported": false
      },
      {
        "name": "EntryFormAbility",
        "srcEntry": "./ets/entryformability/EntryFormAbility.ets",
        "type": "form",
        "description": "$string:form_desc",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ]
  }
}
